# ──────────────────────────────────────────────────────────────────────────────
# VRYFD Backend Environment Variables
# Multi-Chain Support: Gnosis, Polygon, Sepolia
# ──────────────────────────────────────────────────────────────────────────────

# ── Node Environment ──
NODE_ENV=development
PORT=3001

# ── Frontend Configuration ──
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_URL=http://localhost:3001

# ── Multi-Chain Blockchain Configuration ──

# Gnosis Chain (Primary - Mainnet)
GNOSIS_RPC_URL=https://rpc.gnosischain.com
GNOSIS_PRIVATE_KEY=0x...
GNOSISSCAN_API_KEY=your-gnosisscan-api-key
GNOSIS_ATTENDANCE_ADDRESS=0x...
GNOSIS_VRYF_TOKEN_ADDRESS=0x...

# Polygon PoS (Secondary - Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=0x...
POLYGONSCAN_API_KEY=your-polygonscan-api-key
POLYGON_ATTENDANCE_ADDRESS=0x...
POLYGON_VRYF_TOKEN_ADDRESS=0x...

# Sepolia Testnet (Development)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
PRIVATE_KEY=0x...
ETHERSCAN_API_KEY=your-etherscan-api-key
SEPOLIA_ATTENDANCE_ADDRESS=0x...
SEPOLIA_VRYF_TOKEN_ADDRESS=0x...

# Gnosis Chiado Testnet (Development)
CHIADO_RPC_URL=https://rpc.chiadochain.net
CHIADO_ATTENDANCE_ADDRESS=0x...
CHIADO_VRYF_TOKEN_ADDRESS=0x...

# ── Legacy Configuration (Backward Compatibility) ──
# These are used as fallbacks for Sepolia if the new format is not set
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_VRYF_TOKEN_ADDRESS=0x...

# ── Relayer Configuration ──
# Backend relayer private key for webinar attendance recording
# This wallet needs to be authorized as a backend relayer via addBackendRelayer()
# Can be the same as PRIVATE_KEY or a separate dedicated wallet
BACKEND_RELAYER_PRIVATE_KEY=0x...

# ── Database Configuration ──
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/vryfd
# Or for MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/vryfd?retryWrites=true&w=majority

# ── Webinar Integration ──
# Webhook secret for verifying webinar platform callbacks (Zoom, Google Meet, etc.)
WEBINAR_WEBHOOK_SECRET=your-webhook-secret-here

# Comma-separated list of allowed webinar platform origins for CORS
WEBINAR_ORIGINS=https://zoom.us,https://meet.google.com

# ── IPFS Configuration ──
# Pinata API credentials for IPFS pinning
PINATA_API_KEY=your-pinata-api-key
PINATA_SECRET_API_KEY=your-pinata-secret-key

# ── Admin Authentication ──
# Secret key for admin endpoints (used in adminAuth middleware)
ADMIN_SECRET=your-admin-secret-here

# Comma-separated list of admin wallet addresses (lowercase)
# These addresses will have admin access to the dashboard
ADMIN_WALLETS=0x1234...,0x5678...

# Admin session secret for JWT tokens (optional)
ADMIN_SESSION_SECRET=your-admin-session-secret-here

# ── REST API Configuration ──
# Rate limiting for API endpoints (requests per minute)
API_RATE_LIMIT=100

# Webhook retry configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_TIMEOUT=5000

# ── Optional: Alchemy API Key ──
# For ENS resolution and mainnet queries
ALCHEMY_API_KEY=your-alchemy-api-key

# ──────────────────────────────────────────────────────────────────────────────
# Multi-Chain Deployment Notes:
# ──────────────────────────────────────────────────────────────────────────────
# 1. For production, use separate private keys for each chain for security
# 2. Gnosis Chain is the primary network (lowest fees)
# 3. Polygon is the secondary network (wider adoption)
# 4. Sepolia and Chiado are for testing only
# 5. After deploying contracts, update the *_ATTENDANCE_ADDRESS and 
#    *_VRYF_TOKEN_ADDRESS variables for each chain
# 6. The backend will automatically detect which chains are configured
#    and enable multi-chain support accordingly
# ──────────────────────────────────────────────────────────────────────────────
