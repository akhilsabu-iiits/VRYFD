# ============================================
# VRYFD Project — Environment Variables
# Multi-Chain Support: Gnosis, Polygon, Sepolia
# Copy this to .env and fill in your values
# ============================================

# --- Blockchain Networks ---

# Gnosis Chain (Primary - Mainnet)
GNOSIS_RPC_URL=https://rpc.gnosischain.com
GNOSIS_PRIVATE_KEY=your_gnosis_deployer_private_key
GNOSISSCAN_API_KEY=your_gnosisscan_api_key
GNOSIS_ATTENDANCE_ADDRESS=
GNOSIS_VRYF_TOKEN_ADDRESS=

# Polygon PoS (Secondary - Mainnet)
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=your_polygon_deployer_private_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
POLYGON_ATTENDANCE_ADDRESS=
POLYGON_VRYF_TOKEN_ADDRESS=

# Sepolia Testnet (Development)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
PRIVATE_KEY=your_testnet_private_key
ETHERSCAN_API_KEY=your_etherscan_api_key
SEPOLIA_ATTENDANCE_ADDRESS=
SEPOLIA_VRYF_TOKEN_ADDRESS=

# Gnosis Chiado Testnet (Development)
CHIADO_RPC_URL=https://rpc.chiadochain.net
CHIADO_ATTENDANCE_ADDRESS=
CHIADO_VRYF_TOKEN_ADDRESS=

# Polygon Mumbai Testnet (Development - Deprecated)
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# --- Legacy Contract Addresses (Backward Compatibility) ---
# These are used as fallbacks for Sepolia if the new format is not set
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_VRYF_TOKEN_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=100

# --- Frontend RPC URLs (Optional - uses defaults if not set) ---
NEXT_PUBLIC_GNOSIS_RPC_URL=https://rpc.gnosischain.com
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CHIADO_RPC_URL=https://rpc.chiadochain.net

# --- IPFS (Pinata) ---
PINATA_JWT=your_pinata_jwt

# --- Frontend ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_id

# --- Backend ---
PORT=3001
# Alchemy API key — backend only (no NEXT_PUBLIC_ prefix = never in browser bundle).
# Used for ENS lookups and mainnet RPC. Keep this private.
ALCHEMY_API_KEY=your_alchemy_key
# Shared secret protecting organizer/admin routes.
# Set to any strong random string (e.g. openssl rand -hex 32).
ADMIN_SECRET=change_me_to_a_strong_random_secret
# Allowed CORS origin — set to your deployed frontend URL (e.g. https://vryfd.vercel.app).
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of the backend — used in QR codes on certificates.
# Set to your deployed backend URL in production (e.g. https://vryfd-backend.up.railway.app).
# Defaults to http://localhost:3001 if not set (QR codes only work locally).
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# --- MongoDB (Optional) ---
MONGODB_URI=mongodb://localhost:27017/vryfd

# --- Webinar Integration (Optional) ---
# Comma-separated list of allowed webinar platform origins
WEBINAR_ORIGINS=https://zoom.us,https://meet.google.com
