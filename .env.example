# ============================================
# VRYFD Project — Environment Variables
# Network: Sepolia Testnet
# Copy this to .env and fill in your values
# ============================================

# --- Blockchain (Sepolia) ---
PRIVATE_KEY=your_vryfd_dev_wallet_private_key
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/your_alchemy_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# --- Contract Addresses (filled after deploy) ---
NEXT_PUBLIC_CONTRACT_ADDRESS=
NEXT_PUBLIC_VRYF_TOKEN_ADDRESS=
NEXT_PUBLIC_CHAIN_ID=11155111

# --- IPFS (Pinata) ---
PINATA_JWT=your_pinata_jwt

# --- Frontend ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_id

# --- Backend ---
PORT=3001
# Alchemy API key — backend only (no NEXT_PUBLIC_ prefix = never in browser bundle).
# Used for ENS lookups and mainnet RPC. Keep this private.
ALCHEMY_API_KEY=your_alchemy_key
# Shared secret protecting organizer/admin routes.
# Set to any strong random string (e.g. openssl rand -hex 32).
ADMIN_SECRET=change_me_to_a_strong_random_secret
# Allowed CORS origin — set to your deployed frontend URL (e.g. https://vryfd.vercel.app).
FRONTEND_ORIGIN=http://localhost:3000
# Public URL of the backend — used in QR codes on certificates.
# Set to your deployed backend URL in production (e.g. https://vryfd-backend.up.railway.app).
# Defaults to http://localhost:3001 if not set (QR codes only work locally).
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
